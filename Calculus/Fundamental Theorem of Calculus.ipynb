     "text": [
      "∫₀² x² dx = 8/3\n"
     ]
    }
   ],
   "source": [
    "import sympy as sp\n",
    "\n",
    "# Define the variable\n",
    "x = sp.Symbol('x')\n",
    "\n",
    "# Define the function\n",
    "f = x**2\n",
    "\n",
    "# Compute the definite integral from 0 to 2\n",
    "result = sp.integrate(f, (x, 0, 2))\n",
    "print(\"∫₀² x² dx =\", result)\n"
   ]
  },
